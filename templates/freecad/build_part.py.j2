# FreeCAD macro template (Jinja) — generated by planner params
import FreeCAD as App
import Part

doc = App.newDocument("nemoclaw")
length = {{ length_mm | default(50) }}
width = {{ width_mm | default(30) }}
height = {{ height_mm | default(10) }}
box = doc.addObject("Part::Box", "Box")
box.Length = length
box.Width = width
box.Height = height
doc.recompute()
import Mesh
Mesh.export([box], "{{ output_stl }}")
