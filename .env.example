# Copy to ~/.nemoclaw/.env (setup.sh does this on first run)

DISCORD_BOT_TOKEN=
OPENCLAW_GATEWAY_URL=http://localhost:3000
OPENCLAW_API_TOKEN=
OPENCLAW_MODEL=nvidia/nemotron-3-super-120b-a12b

NEMCLAW_DATA_DIR=~/.local/state/nemoclaw
NEMCLAW_API_HOST=127.0.0.1
NEMCLAW_API_PORT=8765
NEMCLAW_DRY_RUN=0
