# Executor-only secrets (~/.openclaw-engineering/.env)
# Discord, Gmail, Nemotron → ~/.openclaw/.env via OpenClaw configure.sh

ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
ONSHAPE_DOCUMENT_ID=
ONSHAPE_WORKSPACE_ID=
ONSHAPE_ELEMENT_ID=

OPENCLAW_ENGINEERING_DATA_DIR=~/.local/state/openclaw-engineering
OPENCLAW_ENGINEERING_API_HOST=127.0.0.1
OPENCLAW_ENGINEERING_API_PORT=8765
OPENCLAW_ENGINEERING_DRY_RUN=0
OPENCLAW_ENGINEERING_FREECAD_APPIMAGE=~/.local/share/openclaw-engineering/apps/FreeCAD.AppImage

# Optional default email hint for DELIVERY.json (actual send via OpenClaw Gmail)
OPENCLAW_ENGINEERING_NOTIFY_EMAIL=

# Optional LEAP71 PicoGK (see docs/PICOGK.md, scripts/install_picogk.sh)
OPENCLAW_ENGINEERING_PICOGK_ENABLED=0
# PICOGK_RUNTIME_PATH=/path/to/libPicoGK.so

# OpenClaw gateway (usually auto from ~/.openclaw/.env)
OPENCLAW_GATEWAY_URL=http://localhost:3000
OPENCLAW_API_TOKEN=
OPENCLAW_HOOK_TOKEN=
